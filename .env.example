# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real credentials.

# --- Database (required) -----------------------------------------------
# MongoDB Atlas connection string.
# Atlas > Connect > Drivers > Python. URL-encode special characters in the
# password (@ becomes %40, # becomes %23).
MONGO_CONNECTION_STRING=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# --- AI provider (required) --------------------------------------------
# Option A: OpenAI — used for summarisation, transcription, and speech.
OPENAI_API_KEY=sk-your-key-here

# Option B: Gemini free tier. See "Running on Gemini" in the README.
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-2.5-flash
# TTS_ENGINE=gtts          # or "edge" for more natural speech (pip install edge-tts)
# TTS_LANG=en

# --- Real-time audio (required for live sessions) ----------------------
# Free project at https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret